# ---- Server ----
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/whisper_chain
# Used to sign session cookies. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Admin dashboard + export token (send as x-admin-token header / paste into /admin)
ADMIN_TOKEN=change-me-admin

# ---- Auth ----
# Google Identity Services web client id (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
# When GOOGLE_CLIENT_ID is empty, DEV_LOGIN=true enables email-only login for local testing
DEV_LOGIN=true

# ---- Chain rules ----
MAX_HOPS=6                # hops per chain after the seed (seed = hop 0)
MODEL_EVERY_N=3           # in MIXED chains every Nth hop is a model hop (3 -> hops 3 and 6)
COMPOSITION_ALL_HUMAN=0.3 # probabilities used when an uploaded seed has no explicit composition
COMPOSITION_ALL_MODEL=0.2
COMPOSITION_MIXED=0.5
ASSIGNMENT_TTL_MIN=20     # a participant holds a chain head for this long before it is released
MAX_AUDIO_LISTENS=3
MAX_AUDIO_TAKES=3
MAX_AUDIO_SECONDS=60
TEXT_READ_SECONDS=300

# ---- Model providers (all have free tiers) ----
# Google AI Studio key: https://aistudio.google.com/apikey  (LLM, audio-in ALM, TTS)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
# Groq key: https://console.groq.com/keys  (Whisper transcription + Llama)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# Which pipeline handles model hops in AUDIO chains: ALM | WHISPER | ALTERNATE
AUDIO_MODEL_KIND=ALTERNATE
MODEL_WORKER_INTERVAL_MS=15000
